# Everything in this file is optional: the console's first-run setup can take the
# credentials instead (stored encrypted in DATA_DIR). Values set here always win.

# --- Credentials ---
# Leave blank to enter them in the console (Connections → Credentials).
BAMBOO_SUBDOMAIN=                     # the part before .bamboohr.com
BAMBOO_API_KEY=
GOOGLE_ADMIN=                         # super admin impersonated by the service account
GOOGLE_CREDENTIALS=                   # path to the key file, or the JSON itself

# --- UI ---
UI_USER=admin
UI_PASSWORD=                          # empty = create one in the console on first visit
ENCRYPTION_KEY=                       # encrypts credentials saved in the console; empty = generated into DATA_DIR/secret.key
PORT=3000
DATA_DIR=./data                       # run history + settings saved from the UI
TZ=UTC                               # timezone for the schedule

# --- Optional ---
# INITIAL_PASSWORD=                   # default: random per user (they reset on first login)
# BAMBOO_BASE_URL=                   # override the API base URL (rarely needed)

# --- Slack alerts ---
SLACK_WEBHOOK_URL=                    # Slack Incoming Webhook URL (secret); can also be set in the console
NOTIFY_ON=failures                    # failures | always | off (editable in the UI)
PUBLIC_URL=                           # where the console is reachable; adds a "View run" link

# --- Branding (white-label; all editable later in the UI's Settings tab) ---
APP_NAME=                             # empty = "Directory Sync"
LOGO_URL=                             # https://... square image
ACCENT_COLOR=                         # 6-digit hex; empty = #4F8CFF
SUPPORT_CONTACT=                      # email or URL shown in the sidebar

# --- Sync behaviour defaults (all editable later in the UI's Settings tab) ---
# Every default is neutral. Fill in what applies to your tenant.
SYNC_SCHEDULE=                        # cron, e.g. "0 2 * * *" for 02:00 daily; empty = no schedule
SCHEDULE_DRY_RUN=false
NEW_USER_OU=/                         # OU path for new users
SUSPENDED_OU=                         # OU path; empty keeps the user's OU
PROTECTED_OUS=                        # comma separated; users here are never suspended
MANAGED_DOMAINS=                      # comma separated; empty = domains already used in your Workspace
RECOVERY_EMAIL=                       # shared inbox; suspended users get inbox+first.last@
LICENSE_PRODUCT_ID=Google-Apps
LICENSE_SKUS=                         # comma separated SKU ids, revoked on suspension
CUSTOM_SCHEMA=                        # Google custom schema name; empty = off
CUSTOM_FIELDS=                        # GoogleField:bambooField pairs, comma separated
SUSPEND_MISSING=true
REACTIVATE_SUSPENDED=false
MAX_SUSPENSIONS_PER_RUN=10
CONCURRENCY=5
